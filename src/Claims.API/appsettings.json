{
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=ClaimsDb;User Id=sa;Password=Your_strong_Passw0rd!;TrustServerCertificate=True"
  },
  "Database": { "Provider": "SqlServer" },
  "Jwt": {
    "Key": "DEV-ONLY-change-me-this-key-must-be-at-least-32-chars-long",
    "Issuer": "claims-platform",
    "Audience": "claims-platform-clients",
    "ExpiryMinutes": 60
  },
  "Kafka": {
    "Enabled": false,
    "BootstrapServers": "localhost:9092",
    "Topic": "claims.events",
    "ConsumerGroup": "claims-auto-assignment"
  },
  "Storage": { "Path": "App_Data/uploads" },
  "Seed": { "Enabled": true },
